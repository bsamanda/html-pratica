<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <title>responsive</title>

    <style>
       
        table {
            width: 100%;
            height: 100vh;
            border-collapse: collapse;
            table-layout: fixed;
              margin:0;
            padding:0;
            border-collapse: collapse;
        }


        td {
            border: 1px solid black;
            text-align: center;
            font-size: 20px;
            padding: 10px;
        }

        colgroup col:nth-child(odd) {
            background-color: rgb(96, 155, 135);
        }

        colgroup col:nth-child(even) {
            background-color: pink;
        }
    </style>
</head>

<body>
    <table>
        <colgroup>
            <col>
            <col>
        </colgroup>
